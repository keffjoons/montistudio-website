---
import Base from '../layouts/Base.astro';
import Studio from '../components/Studio.astro';
import { getPortfolio } from '../data/portfolio';
export async function getStaticPaths() {
  const items = await getPortfolio();
  return [
    ...['photo', 'video', 'about', 'book'].map(path => ({ params: { path } })),
    ...items.map(item => ({ params: { path: `${item.type === 'video' ? 'video' : 'photo'}/${item.id}` } })),
  ];
}
const [initialView, initialId] = Astro.params.path!.split('/');
const names: Record<string, string> = { photo: 'Photo', video: 'Video', about: 'About', book: 'Book' };
---
<Base title={`${names[initialView]} — Monti Studio`}><Studio initialView={initialView} initialId={initialId} /></Base>
